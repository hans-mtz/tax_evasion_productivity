@article{Virmani1989,
   abstract = {Although a number of papers have considered the issue of income tax evasion, few have considered indirect tax evasion. One of the exceptions is a paper which considers the very special case of a risk-averse monopolist producer. The present paper addresses the issue of indirect tax evasion in a competitive market. Evasion in such a market is shown to be associated with production inefficiency. The results also suggest that Laffer-type curves could arise due to evasion.},
