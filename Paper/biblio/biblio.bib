}

@article{Brown2018,
  author = {J. David Brown and Gustavo A. Crespi and Leonardo Iacovone and Luca Marcolin},
  title = {Decomposing firm-level productivity growth and assessing its determinants: evidence from the Americas},
  year = {2018},
  journal = {Journal of Technology Transfer},
  publisher = {Springer New York LLC},
  volume = {43},
  pages = {1571-1606},
  doi = {10.1007/S10961-018-9678-0/TABLES/8},
  url = {https://link.springer.com/article/10.1007/s10961-018-9678-0},
  abstract = {This paper provides novel empirical evidence on productivity growth in the manufacturing sector in Chile, Colombia, Mexico and Peru. Relying on plant-level data, we first decompose productivity and productivity growth into plant-level growth and market allocation forces. While the average productivity of the survivors is higher than the overall contribution of reallocation forces, during recessions the inverse is true and reallocation gives a positive, albeit small, contribution to aggregate productivity growth. Next we analyze how policy measures can determine allocative efficiency levels and growth, and find important scope for action on education, financial regulation, and structural reforms.},
  issn = {15737047},
  issue = {6},
  keywords = {Decompositions,Growth,Plant-level,Productivity,Regulation},
  month = {12}
}

