@article{Kang2021,
   abstract = {Nonparametric deconvolution in density estimation and its companion in regression (i.e., nonparametric regression with measurement errors) have broad applications. Many nonparametric deconvolution methods in the errors-in-variables literature are based on kernel estimation. There are also some nonparametric deconvolution methods constructed based on the Fourier Transformation (since-cosine series), splines, wavelet, and other function expansions in specific basis function spaces. We introduce representative methods in the latter type, as well as a low order approximation that can be used when the error distribution is unknown and the error variance is small. Some recent methods in the related image deblurring area are also described. We consider two types of errors in this inverse problem: supersmooth errors and ordinary smooth errors.},
   author = {Yicheng Kang and Peihua Qiu},
   doi = {10.1201/9781315101279-11},
   isbn = {9781315101279},
   journal = {Handbook of Measurement Error Models},
   month = {10},
   pages = {221-244},
   publisher = {Chapman and Hall/CRC},
   title = {Nonparametric Deconvolution by Fourier Transformation and Other Related Approaches},
   url = {https://www-taylorfrancis-com.proxy1.lib.uwo.ca/chapters/edit/10.1201/9781315101279-11/nonparametric-deconvolution-fourier-transformation-related-approaches-yicheng-kang-peihua-qiu},
   year = {2021},
}
@article{Yi2021,
   abstract = {The likelihood inference framework has been widely used to handle measurement error problems. Such a framework enjoys great generality and flexibility for handling various complex models. A variety of likelihood-based methods have been developed in the literature. In this chapter we provide a unified setup and discuss several strategies derived from the likelihood formulation to account for the measurement error effects. Relevant issues and extensions are outlined as well.},
   author = {Grace Y. Yi},
   doi = {10.1201/9781315101279-6},
   isbn = {9781315101279},
   journal = {Handbook of Measurement Error Models},
   month = {10},
   pages = {99-126},
   publisher = {Chapman and Hall/CRC},
   title = {Likelihood Methods with Measurement Error and Misclassification},
   url = {https://www-taylorfrancis-com.proxy1.lib.uwo.ca/chapters/edit/10.1201/9781315101279-6/likelihood-methods-measurement-error-misclassification-grace-yi},
   year = {2021},
}
