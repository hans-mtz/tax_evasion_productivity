\begin_layout Standard
For corporations
\begin_inset Formula 
\[
s_{ijt}=\gamma_{j}+\varepsilon_{ijt}
\]

\end_inset

Define
\begin_inset Formula 
\[
\widehat{s}_{ijt}=s_{ijt}-\widehat{\gamma}_{j}
\]

\end_inset


\begin_inset Formula 
\[
E^{C}\left[\widehat{s}_{ijt}\mid x_{ijt}\right]=E\left[\varepsilon_{ijt}\mid x_{ijt}\right]
\]

\end_inset


\end_layout

\begin_layout Standard
For non-corporations
\begin_inset Formula 
\[
s_{ijt}=\gamma_{j}+e_{ijt}+\varepsilon_{ijt}
\]

\end_inset


\begin_inset Formula 
\[
E^{N}\left[\widehat{s}_{ijt}\mid x_{ijt}\right]=E\left[e_{ijt}\mid x_{ijt}\right]+E\left[\varepsilon_{ijt}\mid x_{ijt}\right]
\]

\end_inset

Then
\begin_inset Formula 
\begin{align*}
E\left[\widehat{s}_{ijt}\mid x_{ijt}\right] & =E\left[\widehat{s}_{ijt}^{C}\mid x_{ijt}\right]\left(1-D_{ijt}^{N}\right)+E\left[\widehat{s}_{ijt}^{N}\mid x_{ijt}\right]D_{ijt}^{N}\\
 & =E\left[\widehat{s}_{ijt}^{C}\mid x_{ijt}\right]+D_{ijt}^{N}\left(E\left[\widehat{s}_{ijt}^{N}\mid x_{ijt}\right]-E\left[\widehat{s}_{ijt}^{C}\mid x_{ijt}\right]\right)\\
 & =E\left[\varepsilon_{ijt}\mid x_{ijt}\right]+D_{ijt}^{N}E\left(e_{ijt}\mid x_{ijt}\right)
\end{align*}

\end_inset


\begin_inset Formula 
\begin{align*}
\widehat{s}_{ijt} & =E\left[\varepsilon_{ijt}\mid x_{ijt}\right]+D_{ijt}^{N}E\left(e_{ijt}\mid x_{ijt}\right)+\eta_{ijt}\\
 & =\sum_{k=1}^{10}1\!\!1\left(x_{ijt}\in\mathcal{X}_{k}\right)\beta_{k}+D_{ijt}\sum_{k=1}^{10}1\!\!1\left(x_{ijt}\in\mathcal{X}_{k}\right)\mu_{k}+\eta_{ijt}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
***************************************************************************************************
\end_layout

\begin_layout Standard
\begin_inset Formula 
\[
s_{ijt}=\gamma_{j}+\sum_{k=1}^{10}1\!\!1\left(x_{ijt}\in\mathcal{X}_{k}\right)\beta_{k}+D_{ijt}\sum_{k=1}^{10}1\!\!1\left(x_{ijt}\in\mathcal{X}_{k}\right)\mu_{k}+\eta_{ijt}
\]

\end_inset

Lo que escribi arriba
\begin_inset Formula 
\[
\widehat{s}_{ijt}=\sum_{k=1}^{10}1\!\!1\left(x_{ijt}\in\mathcal{X}_{k}\right)\beta_{k}+D_{ijt}\sum_{k=1}^{10}1\!\!1\left(x_{ijt}\in\mathcal{X}_{k}\right)\mu_{k}+\underset{\zeta_{ijt}}{\underbrace{\left\{ \eta_{ijt}+\left(\gamma_{j}-\widehat{\gamma}_{j}\right)\right\} }}
\]

\end_inset


